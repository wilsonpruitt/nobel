---
interface Props {
  title?: string;
  description?: string;
}

const SITE = 'Laureates for the Pulpit';
const {
  title,
  description = 'Recent Nobel Prizes explained in plain terms for pastors: what was found, how to say it accurately, and where it meets preaching in the Wesleyan tradition.',
} = Astro.props;
const fullTitle = title ? `${title} | ${SITE}` : SITE;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{fullTitle}</title>
    <script defer src="/_vercel/insights/script.js"></script>
  </head>
  <body class="bg-parchment text-ink font-serif min-h-screen flex flex-col antialiased">
    <header class="border-b border-gold/20 bg-parchment/80 backdrop-blur-sm sticky top-0 z-50">
      <div class="max-w-4xl mx-auto px-4 py-4 flex items-baseline justify-between gap-4">
        <a href="/" class="group">
          <p class="font-sans font-bold text-lg tracking-tight text-ink group-hover:text-gold transition-colors">
            {SITE}
          </p>
          <p class="text-xs text-ink-light font-sans">Nobel Prizes for Preachers</p>
        </a>
        <nav class="font-sans text-sm text-ink-light flex items-baseline gap-4 whitespace-nowrap">
          <a href="/#ledger" class="hover:text-gold transition-colors">All Prizes</a>
          <a href="https://wrootpress.com" class="hover:text-gold transition-colors">Wroot Press</a>
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-gold/20 py-8 mt-12">
      <div class="max-w-4xl mx-auto px-4 text-center font-sans text-sm text-ink-light">
        <p>
          A digital edition of <a href="https://wrootpress.com" class="hover:text-gold transition-colors underline-offset-2 hover:underline">Wroot Press</a>
        </p>
        <p class="mt-1 text-xs">Scripture quotations are from the World English Bible, which is in the public domain.</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
